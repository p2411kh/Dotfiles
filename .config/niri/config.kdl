// ~/.config/niri/config.kdl
// Портировано из Hyprland-конфига.
// Формат KDL: https://kdl.dev
// Полный референс: https://github.com/YaLTeR/niri/wiki/Configuration:-Overview

// ------------------------------------------------------------------
// ГЛАВНОЕ: убирает крестик/квадрат/минус на окнах (client-side decorations).
// niri попросит приложения не рисовать свой заголовок. После включения/
// выключения нужно перезапустить уже открытые приложения, чтобы применилось.
// Побочный эффект: пропадают "хваталки" за края окна для ресайза мышкой —
// ресайзить можно через Mod + ПКМ (см. бинды ниже) либо set-column-width.
// ------------------------------------------------------------------
prefer-no-csd


// --------------------
// КЛАВИАТУРА / МЫШЬ
// --------------------
input {
    keyboard {
        xkb {
            layout "us,ru"
            variant ",phonetic"
            options "grp:win_space_toggle"
        }
    }

    touchpad {
        // natural_scroll = false в исходнике
        tap
    }

    mouse {
        accel-profile "flat"
    }

    // аналог hl.gesture (3 пальца = свайп по воркспейсам) —
    // жест уже встроен в niri по умолчанию на тачпаде
}

// --------------------
// КУРСОР (аналог hl.env XCURSOR_*)
// --------------------
cursor {
    xcursor-theme "Bibata-Modern-Ice"
    xcursor-size 19
}

// --------------------
// МОНИТОРЫ
// --------------------
// Замени "eDP-1" на реальное имя выхода (узнать: niri msg outputs)
output "eDP-1" {
    scale 1
    mode "1920x1080@60"
    position x=0 y=0
}

// --------------------
// АВТОЗАПУСК (аналог hl.on("hyprland.start", ...))
// --------------------
spawn-at-startup "swaybg" "-i" "/home/p2411kh/Dotfiles/wallpeper/photo_2026-06-19_18-38-43.jpg" "-m" "fill"  // замена hyprpaper
// spawn-at-startup "waybar"          // замена noctalia — noctalia заточен под Hyprland IPC и под niri не запустится
spawn-at-startup "pipewire"
spawn-at-startup "wireplumber"
spawn-at-startup "pipewire-pulse"
spawn-at-startup "noctalia"

// именованный воркспейс под "special:magic" из оригинала
workspace "scratch"

// --------------------
// LOOK & FEEL (аналог decoration / general из Hyprland)
// --------------------
layout {
    gaps 5

    focus-ring {
        // off
        width 2
        active-color "#98971aee"
        inactive-color "#595959aa"
    }

    // border не используем, чтобы не дублировать focus-ring — как и в
    // исходнике, где активна была только цветная active_border
    border {
        off
        

    }

    shadow {
        on
        softness 12
        spread 3
        offset x=0 y=4
        color "#1a1a1aee"
    }

    struts {
        left 15
        right 15
        top 15
        bottom 15
    }
}

// скругления (аналог decoration.rounding = 20)
// работает корректно только вместе с prefer-no-csd
window-rule {
    geometry-corner-radius 20
    clip-to-geometry true
    match app-id="kitty"
    draw-border-with-background false
    background-effect {
        blur true
    }
}

layer-rule {
    match namespace=".*"
    background-effect {
        blur true
    }
}

// --------------------
// АНИМАЦИИ
// --------------------
// Hyprland-овские пружины/безье 1-в-1 не переносятся — у niri свой набор
// анимаций с похожими принципами. Оставляем дефолтные (enabled = true).
animations {
    // slowdown 1.0
}

// --------------------
// ХОТКЕИ
// --------------------
binds {

    Mod+F { switch-preset-column-width; }
    Mod+Shift+Slash { show-hotkey-overlay; }

    // терминал (аналог SUPER+Q)
    Mod+Q { spawn "kitty"; }

    // закрыть окно (SUPER+C)
    Mod+C { close-window; }

    // выход (SUPER+M) — niri сам показывает диалог подтверждения
    Mod+M { quit; }

    // файловый менеджер (SUPER+E)
    Mod+E { spawn "dolphin"; }

    // тогл плавающего окна (SUPER+V)
    Mod+V { toggle-window-floating; }

    // браузер (SUPER+B)
    Mod+B { spawn "zen-browser"; }

    // псевдо-тайлинг из Hyprland аналога в niri нет — ближайшее по духу:
    // ресайз колонки (SUPER+P оставляем на смену пресетной ширины)
    Mod+P { switch-preset-column-width; }

    // togglesplit (dwindle-only) — ближайший аналог: смена пресетной ширины
    Mod+J { switch-preset-column-width; }

    // лаунчер (SUPER+R), как и было в оригинале — wofi
    Mod+R { spawn-sh "noctalia msg panel-toggle launcher"; }

    // фокус в направлении (стрелки)
    Mod+Left  { focus-column-left; }
    Mod+Right { focus-column-right; }
    Mod+Up    { focus-window-up; }
    Mod+Down  { focus-window-down; }

    // перемещение окна/колонки (бонус, в оригинале не было)
    Mod+Shift+Left  { move-column-left; }
    Mod+Shift+Right { move-column-right; }
    Mod+Shift+Up    { move-window-up; }
    Mod+Shift+Down  { move-window-down; }

    // переключение / перенос на воркспейс 1-10
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }
    Mod+0 { focus-workspace 10; }

    Mod+Shift+1 { move-column-to-workspace 1; }
    Mod+Shift+2 { move-column-to-workspace 2; }
    Mod+Shift+3 { move-column-to-workspace 3; }
    Mod+Shift+4 { move-column-to-workspace 4; }
    Mod+Shift+5 { move-column-to-workspace 5; }
    Mod+Shift+6 { move-column-to-workspace 6; }
    Mod+Shift+7 { move-column-to-workspace 7; }
    Mod+Shift+8 { move-column-to-workspace 8; }
    Mod+Shift+9 { move-column-to-workspace 9; }
    Mod+Shift+0 { move-column-to-workspace 10; }

    // спец-воркспейс "magic" (аналог scratchpad из оригинала)
    Mod+S       { focus-workspace "scratch"; }
    Mod+Shift+S { move-column-to-workspace "scratch"; }

    // скролл колесом по воркспейсам (аналог mainMod + mouse_up/down)
    Mod+WheelScrollDown cooldown-ms=150 { focus-workspace-down; }
    Mod+WheelScrollUp   cooldown-ms=150 { focus-workspace-up; }

    // перемещение/ресайз окна мышью (аналог mainMod+ЛКМ/ПКМ drag)
    Mod+Ctrl+Right { set-column-width "+10%"; }
    Mod+Ctrl+Left  { set-column-width "-10%"; }

    // мультимедиа/яркость — команды один в один из оригинала
    XF86AudioRaiseVolume allow-when-locked=true { spawn "wpctl" "set-volume" "-l" "1" "@DEFAULT_AUDIO_SINK@" "5%+"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "5%-"; }
    XF86AudioMute        allow-when-locked=true { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SINK@" "toggle"; }
    XF86AudioMicMute     allow-when-locked=true { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SOURCE@" "toggle"; }
    XF86MonBrightnessUp   allow-when-locked=true { spawn "brightnessctl" "-e4" "-n2" "set" "5%+"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "brightnessctl" "-e4" "-n2" "set" "5%-"; }
    XF86AudioNext  { spawn "playerctl" "next"; }
    XF86AudioPause { spawn "playerctl" "play-pause"; }
    XF86AudioPlay  { spawn "playerctl" "play-pause"; }
    XF86AudioPrev  { spawn "playerctl" "previous"; }

    Mod+Escape allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }
}

