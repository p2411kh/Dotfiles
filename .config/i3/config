# i3 config — converted from Hyprland (hyprland.conf)
# Gruvbox accent color: #98971a

set $mod Mod4

# Fonts
font pango:JetBrainsMono Nerd Font 10

#############
# PROGRAMS  #
#############
set $terminal kitty
set $fileManager dolphin
set $menu rofi -show drun
set $browser firefox
set $telegram telegram-desktop

#############
# AUTOSTART #
#############
exec_always --no-startup-id feh --bg-fill ~/Dotfiles/wallpeper/photo_2026-06-19_18-38-43.jpg
exec_always --no-startup-id polybar main
exec --no-startup-id nm-applet
exec --no-startup-id feh --bg-fill ~/Pictures/wallpapers/photo_2026-06-19_18-38-43.jpg
# awww-daemon has no X11 equivalent needed — feh sets the wallpaper directly

#############
# LOOK      #
#############
gaps inner 5
gaps outer 10

for_window [class="^.*"] border pixel 3

# class                 border  bground text    indicator child_border
client.focused          #98971a #98971a #ffffff #98971a   #98971a
client.focused_inactive #1d2012 #1d2012 #98971a #1d2012   #1d2012
client.unfocused        #1d2012 #1d2012 #98971a #1d2012   #1d2012
client.urgent            #cc241d #cc241d #ffffff #cc241d   #cc241d

# Allow moving/resizing floating windows with mod+drag (Hyprland's bindm equivalent)
floating_modifier $mod

###################
# KEYBINDINGS     #
###################
bindsym $mod+Q exec $terminal
bindsym $mod+B exec $browser
bindsym $mod+F exec $telegram
bindsym $mod+C kill
bindsym $mod+E exec $fileManager
bindsym $mod+V floating toggle
bindsym $mod+R exec $menu
bindsym $mod+L exec i3lock -c 1d2012

# split / layout toggles (Hyprland's pseudo/togglesplit)
bindsym $mod+P split toggle
bindsym $mod+J layout toggle split

# Move focus with mod + arrow keys
bindsym $mod+Left focus left
bindsym $mod+Right focus right
bindsym $mod+Up focus up
bindsym $mod+Down focus down


# Workspaces 1-10
set $ws1  "1"
set $ws2  "2"
set $ws3  "3"
set $ws4  "4"
set $ws5  "5"
set $ws6  "6"
set $ws7  "7"
set $ws8  "8"
set $ws9  "9"
set $ws10 "10"

bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5
bindsym $mod+6 workspace number $ws6
bindsym $mod+7 workspace number $ws7
bindsym $mod+8 workspace number $ws8
bindsym $mod+9 workspace number $ws9
bindsym $mod+0 workspace number $ws10

bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5
bindsym $mod+Shift+6 move container to workspace number $ws6
bindsym $mod+Shift+7 move container to workspace number $ws7
bindsym $mod+Shift+8 move container to workspace number $ws8
bindsym $mod+Shift+9 move container to workspace number $ws9
bindsym $mod+Shift+0 move container to workspace number $ws10

# Scratchpad (Hyprland's togglespecialworkspace "magic")
bindsym $mod+S scratchpad show
bindsym $mod+Shift+S move scratchpad

# Exit i3 (Hyprland's hyprctl dispatch exit)
bindsym $mod+M exec i3-nagbar -t warning -m 'Выйти из i3?' -B 'Да' 'i3-msg exit'

# Reload/restart i3 config
bindsym $mod+Shift+C reload
bindsym $mod+Shift+R restart

###########################
# MULTIMEDIA / LAPTOP KEYS #
###########################
bindsym XF86AudioRaiseVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ +5%
bindsym XF86AudioLowerVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ -5%
bindsym XF86AudioMute        exec --no-startup-id pactl set-sink-mute @DEFAULT_SINK@ toggle
bindsym XF86AudioMicMute     exec --no-startup-id pactl set-source-mute @DEFAULT_SOURCE@ toggle
bindsym XF86MonBrightnessUp   exec --no-startup-id brightnessctl -e4 -n2 set 5%+
bindsym XF86MonBrightnessDown exec --no-startup-id brightnessctl -e4 -n2 set 5%-

bindsym XF86AudioNext  exec --no-startup-id playerctl next
bindsym XF86AudioPause exec --no-startup-id playerctl play-pause
bindsym XF86AudioPlay  exec --no-startup-id playerctl play-pause
bindsym XF86AudioPrev  exec --no-startup-id playerctl previous

# Resize mode
mode "resize" {
    bindsym Left  resize shrink width 10 px or 10 ppt
    bindsym Down  resize grow height 10 px or 10 ppt
    bindsym Up    resize shrink height 10 px or 10 ppt
    bindsym Right resize grow width 10 px or 10 ppt
    bindsym Return mode "default"
    bindsym Escape mode "default"
}
bindsym $mod+r mode "resize"

# Status bar is handled by polybar (exec_always above), so no i3bar block is needed.
